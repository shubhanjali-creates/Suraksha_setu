const User = require('../models/User');
const OTPVerification = require('../models/OTPVerification');
const jwt = require('jsonwebtoken');
const bcrypt = require('bcryptjs');
const crypto = require('crypto');

const createToken = (user) => {
  const secretKey = process.env.JWT_SECRET;
  if (!secretKey) throw new Error('JWT_SECRET is not configured on the server.');
  return jwt.sign(
    { UserID: user.UserID, Email: user.Email },
    secretKey,
    { expiresIn: '1h' }
  );
};

const normalizeEmail = (email) => String(email || '').trim().toLowerCase();

const validateRegistration = ({ Name, Email, Phone, Password, Address }) => {
  if (!Name || !Email || !Phone || !Password || !Address) return 'Name, email, phone, password and address are required.';
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(normalizeEmail(Email))) return 'Please enter a valid email address.';
  if (!/^\d{10}$/.test(String(Phone))) return 'Phone number must contain exactly 10 digits.';
  if (String(Password).length < 8) return 'Password must be at least 8 characters.';
  return null;
};

const sendVerificationEmail = async (email, otp) => {
  const apiKey = process.env.RESEND_API_KEY;
  const from = process.env.RESEND_FROM_EMAIL;

  if (!apiKey || !from) {
    if (process.env.NODE_ENV !== 'production') {
      console.warn(`[DEV] Email OTP for ${email}: ${otp}`);
      return;
    }
    throw new Error('Email service is not configured. Set RESEND_API_KEY and RESEND_FROM_EMAIL.');
  }

  const response = await fetch('https://api.resend.com/emails', {
    method: 'POST',
    headers: {
      Authorization: `Bearer ${apiKey}`,
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({
      from,
      to: [email],
      subject: 'Verify your Suraksha Setu email',
      html: `
        <div style="font-family:Arial,sans-serif;max-width:560px;margin:auto;padding:28px;color:#172033">
          <div style="background:#0f3d56;color:white;padding:18px 22px;border-radius:14px 14px 0 0">
            <h2 style="margin:0">Suraksha Setu</h2>
            <p style="margin:6px 0 0;opacity:.9">Email verification</p>
          </div>
          <div style="border:1px solid #e5e7eb;border-top:0;padding:26px;border-radius:0 0 14px 14px">
            <p>Use the verification code below to complete your registration:</p>
            <div style="font-size:32px;font-weight:700;letter-spacing:9px;text-align:center;padding:18px;background:#f3f7f9;border-radius:12px;margin:20px 0">${otp}</div>
            <p style="color:#667085">This code expires in 10 minutes. Do not share it with anyone.</p>
            <p style="font-size:13px;color:#98a2b3">If you did not request this, you can safely ignore this email.</p>
          </div>
        </div>`,
    }),
  });

  if (!response.ok) {
    const text = await response.text();
    throw new Error(`Unable to send verification email. ${text}`);
  }
};

const sendOtp = async (req, res) => {
  const data = req.body || {};
  const validationError = validateRegistration(data);
  if (validationError) return res.status(400).json({ error: validationError });

  const email = normalizeEmail(data.Email);
  const phone = String(data.Phone);

  try {
    const existingEmail = await User.findOne({ Email: email }).lean();
    if (existingEmail) return res.status(409).json({ error: 'An account with this email already exists.' });

    const existingPhone = await User.findOne({ Phone: phone }).lean();
    if (existingPhone) return res.status(409).json({ error: 'An account with this phone number already exists.' });

    const existingOtp = await OTPVerification.findOne({ Email: email });
    if (existingOtp && Date.now() - new Date(existingOtp.LastSentAt).getTime() < 60 * 1000) {
      return res.status(429).json({ error: 'Please wait 60 seconds before requesting another OTP.' });
    }

    const otp = String(crypto.randomInt(100000, 1000000));
    const otpHash = await bcrypt.hash(otp, 10);
    const expiresAt = new Date(Date.now() + 10 * 60 * 1000);

    const registrationData = {
      Name: String(data.Name).trim(),
      Email: email,
      Phone: phone,
      Address: String(data.Address).trim(),
      Password: String(data.Password),
    };

    await OTPVerification.findOneAndUpdate(
      { Email: email },
      { OTPHash: otpHash, RegistrationData: registrationData, Attempts: 0, LastSentAt: new Date(), ExpiresAt: expiresAt },
      { upsert: true, new: true, setDefaultsOnInsert: true }
    );

    await sendVerificationEmail(email, otp);
    return res.status(200).json({ message: 'Verification code sent to your email.', expiresIn: 600 });
  } catch (error) {
    console.error('sendOtp:', error);
    return res.status(500).json({ error: error.message || 'Unable to send verification email.' });
  }
};

const verifyOtp = async (req, res) => {
  const email = normalizeEmail(req.body?.Email);
  const otp = String(req.body?.OTP || '').trim();
  if (!email || !/^\d{6}$/.test(otp)) return res.status(400).json({ error: 'Enter the 6-digit verification code.' });

  try {
    const record = await OTPVerification.findOne({ Email: email });
    if (!record) return res.status(400).json({ error: 'No active verification request found. Please request a new OTP.' });
    if (record.ExpiresAt <= new Date()) {
      await OTPVerification.deleteOne({ _id: record._id });
      return res.status(400).json({ error: 'This OTP has expired. Please request a new one.' });
    }
    if (record.Attempts >= 5) {
      await OTPVerification.deleteOne({ _id: record._id });
      return res.status(429).json({ error: 'Too many incorrect attempts. Please request a new OTP.' });
    }

    const matches = await bcrypt.compare(otp, record.OTPHash);
    if (!matches) {
      record.Attempts += 1;
      await record.save();
      return res.status(400).json({ error: `Incorrect OTP. ${Math.max(0, 5 - record.Attempts)} attempts remaining.` });
    }

    const data = record.RegistrationData;
    const existing = await User.findOne({ $or: [{ Email: email }, { Phone: data.Phone }] }).lean();
    if (existing) {
      await OTPVerification.deleteOne({ _id: record._id });
      return res.status(409).json({ error: 'An account with this email or phone number already exists.' });
    }

    const lastUser = await User.findOne().sort({ UserID: -1 }).select('UserID').lean();
    const UserID = lastUser ? lastUser.UserID + 1 : 1;
    const hashedPassword = await bcrypt.hash(data.Password, 10);

    const user = await User.create({
      UserID,
      Name: data.Name,
      Email: data.Email,
      Phone: data.Phone,
      Password: hashedPassword,
      Address: data.Address,
      UserType: ['affected'],
      Available: true,
      Community: [],
      CreationTime: new Date(),
      EmailVerified: true,
    });

    await OTPVerification.deleteOne({ _id: record._id });

    const safeUser = user.toObject();
    delete safeUser.Password;
    return res.status(201).json({ message: 'Email verified. Your account has been created.', user: safeUser, token: createToken(user) });
  } catch (error) {
    if (error.code === 11000) return res.status(409).json({ error: 'An account with these details already exists.' });
    console.error('verifyOtp:', error);
    return res.status(500).json({ error: error.message || 'Unable to verify OTP.' });
  }
};

const register = async (req, res) => {
  // Registration now requires email verification. Keep this endpoint for compatibility,
  // but route new registrations through /auth/send-otp and /auth/verify-otp.
  return res.status(410).json({ error: 'Direct registration is disabled. Please use email OTP verification.' });
};

const login = async (req, res) => {
  const { Email, Password } = req.body;
  if (!Email || !Password) return res.status(400).json({ error: 'Email and password are required.' });

  try {
    const user = await User.findOne({ Email: normalizeEmail(Email) });
    if (!user || user.Active === false || !(await bcrypt.compare(Password, user.Password))) {
      return res.status(401).json({ error: 'Invalid credentials.' });
    }
    const safeUser = user.toObject();
    delete safeUser.Password;
    res.status(200).json({ user: safeUser, token: createToken(user) });
  } catch (error) {
    res.status(500).json({ error: error.message });
  }
};

const me = async (req, res) => {
  const user = await User.findOne({ UserID: req.user.UserID }).select('-Password');
  if (!user) return res.status(404).json({ error: 'User not found.' });
  res.json({ user });
};

module.exports = { register, login, me, sendOtp, verifyOtp };
